set editing-mode vi
# Alternate escape sequences ("jj" not appropriate)
"\C-j": vi-movement-mode

# Everything that prints nothing (cursor shape, colors, reset) must sit inside
# \1 ... \2, or readline counts it as columns and the edit line redraws wrong:
# phantom characters after history recall, at the window edge, and on movement.

$if Bash
set show-mode-in-prompt on
# block cursor and sunflower color from starship.toml
set vi-cmd-mode-string "\1\e[2 q\e[38;2;255;243;82m\2❯\1\e[0m\2"
# bar cursor and mint color from starship.toml
set vi-ins-mode-string "\1\e[6 q\e[38;2;194;255;223m\2❯\1\e[0m\2"
# "foreground" a process without the command going in history
"\C-x": " fg\C-m"
"\C-f": redraw-current-line
set keymap vi-command
"\C-f": redraw-current-line
# readline only binds bracketed paste in vi-insert; pasting while in command
# mode otherwise runs the pasted text as vi commands
"\e[200~": bracketed-paste-begin
$endif

$if Python
set show-mode-in-prompt on
set vi-cmd-mode-string "\1\e[38;2;255;243;82m\2❯❯❯\1\e[0m\2"
set vi-ins-mode-string "\1\e[38;2;194;255;223m\2❯❯❯\1\e[0m\2"
"\C-f": redraw-current-line
set keymap vi-command
"\C-f": redraw-current-line
$endif
